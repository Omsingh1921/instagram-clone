# ============================================================
# INSTAGRAM CLONE — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# Copy this file to .env and provide your production or local credentials.
# Never commit the .env file containing real secrets to version control.
# NOTE: In .env files, always use '=' (equals sign), NEVER ':' (colon).

# --- SERVER & ACTIVE PROFILE ---
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- DATABASE CONFIGURATION (POSTGRESQL / SUPABASE OR MYSQL) ---
# Option A: Full JDBC URL (e.g. Supabase pooler or AWS RDS)
DB_URL=jdbc:postgresql://aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require
DB_HOST=aws-0-ap-southeast-2.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=postgres.your_project_ref
DB_PASSWORD=your_database_password
DB_DRIVER=org.postgresql.Driver

# --- REDIS DISTRIBUTED CACHE & PRESENCE ---
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave blank for local Memurai / standalone Redis without password
REDIS_PASSWORD=

# --- APACHE KAFKA ---
APP_KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=instagram-clone-group

# --- CLOUDINARY MEDIA STORAGE & CDN ---
# Get credentials from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FALLBACK_ON_FAILURE=false

# --- MAIL CONFIGURATION (SMTP / GMAIL) ---
# Leave blank for simulated mock mode (OTPs logged to console & screen hint)
# Or enter real Gmail address and 16-character Google App Password
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

# --- SECURITY & JWT SESSIONS ---
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://likeinstagra.netlify.app

# --- INITIAL ADMIN USER SEEDING ---
APP_ADMIN_USERNAME=admin
APP_ADMIN_EMAIL=admin@instagram.com
APP_ADMIN_PASSWORD=Admin@12345
